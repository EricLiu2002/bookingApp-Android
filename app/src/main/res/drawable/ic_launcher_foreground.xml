###xml/backup_rules.xml
<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: back up only the ledger database. -->
<full-backup-content>
    <include domain="database" path="bookingapp.db" />
</full-backup-content>

###xml/data_extraction_rules.xml
<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: back up and transfer only the ledger database. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="bookingapp.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bookingapp.db" />
    </device-transfer>
</data-extraction-rules>
