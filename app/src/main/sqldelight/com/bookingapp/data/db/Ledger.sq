-- Schema statements are copied verbatim from reference/backend/V1__create_schema.sql and
-- V2__seed_categories.sql. SchemaParityTest fails if they drift from the backend.

CREATE TABLE category (
    id   INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT    NOT NULL UNIQUE
);

CREATE TABLE transaction_entry (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    type         TEXT    NOT NULL CHECK (type IN ('COST', 'EARNING')),
    amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
    entry_date   TEXT    NOT NULL,
    category_id  INTEGER NOT NULL REFERENCES category (id),
    note         TEXT,
    created_at   TEXT    NOT NULL,
    updated_at   TEXT    NOT NULL
);

CREATE INDEX ix_transaction_entry_date_created ON transaction_entry (entry_date, created_at);

